local cachedAng, cachedCos = -1, 0
local function getCos()
if cfg.angleDeg ~= cachedAng then
cachedAng = cfg.angleDeg
cachedCos = math.cos(math.rad(cfg.angleDeg / 2))
end
return cachedCos
end

local function inAngle(camCF, myPos, tPos)
if cfg.angleDeg >= 360 then return true end
local to = (tPos - myPos).Unit
local fwd = camCF.LookVector.Unit
return fwd:Dot(to) >= getCos()
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function refreshRay()
local char = me.Character
rayParams.FilterDescendantsInstances = char and { char } or {}
end

local function visible(fromPos, toPos)
if not cfg.ignoreWalls then return true end
refreshRay()
local dir = toPos - fromPos
local res = pit:Raycast(fromPos, dir, rayParams)
if not res then return true end
local hit = res.Instance
for _, p in ipairs(jail:GetPlayers()) do
if p.Character and hit:IsDescendantOf(p.Character) then return true end
end
return false
end

local rawRemote
local function getRaw()
if rawRemote then return rawRemote end
local ok, v = pcall(function()
return vault.rbxts_include.node_modules:FindFirstChild("@rbxts").net.out._NetManaged.SwordHit
end)
if ok and v then rawRemote = v end
return rawRemote
end

local lastAttack = 0
local targetList = {}

rope.Heartbeat:Connect(function()
if not cfg.enabled then return end
if cfg.requireMouse and not lmb then return end
if cfg.limitToItems and not checkWeaponEquipped() then return end

local r = root()
if not r then return end
local myPos = r.Position
local h = hum()
if not h or h.Health <= 0 then return end

local camCF = abyss.CFrame
table.clear(targetList)

for _, e in ipairs(entity.list) do
if not e.Targetable then continue end
if not entity.isVulnerable(e) then continue end
if cfg.teamCheck and e.Player then
local myTeam = me.Team
local eTeam = e.Player.Team
if myTeam and eTeam and eTeam == myTeam then continue end
end
local rp = e.RootPart
if not rp then continue end
local ePos = rp.Position
local dist = (myPos - ePos).Magnitude
if dist > cfg.range then continue end
if not inAngle(camCF, myPos, ePos) then continue end
if not visible(myPos, ePos) then continue end
table.insert(targetList, {char = e.meat, pos = ePos, dist = dist})
end

table.sort(targetList, function(a, b) return a.dist < b.dist end)

if #targetList > 0 then
local now = tick()
if now - lastAttack >= cfg.attackSpeed then
-- Primary: dynamic combat controller (works for all kit weapons)
if bedReady and combatController and combatController.swingSwordInRegion then
local sz = cfg.hitboxes and (cfg.hitboxExpand / 3) or 3.8
for _, t in ipairs(targetList) do
local reg = CFrame.new(t.pos)
pcall(function()
combatController:swingSwordInRegion(reg, sz)
end)
if not cfg.multiHit then break end
end
lastAttack = now
else
-- Fallback: FireServer with weapon item
local net = getRaw()
local wp = getWeaponItem()
if net and wp then
for _, t in ipairs(targetList) do
local fireSelf = cfg.hitfix and bypass(myPos, t.pos) or myPos
local args = {{
entityInstance = t.char,
chargedAttack = { chargeRatio = 0 },
validate = {
targetPosition = { value = t.pos },
selfPosition = { value = fireSelf },
},
weapon = wp,
}}
pcall(net.FireServer, net, unpack(args))
if not cfg.multiHit then break end
end
lastAttack = now
end
end
end
end
end)

