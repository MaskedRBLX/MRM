local function reveal(raw)
    local s = 1000
    return {
        enabled      = (raw[1] ~= 0),
        range        = raw[2] - s,
        teamCheck    = (raw[3] ~= 0),
        angleDeg     = raw[4] - s,
        requireMouse = (raw[5] ~= 0),
        limitToItems = (raw[6] ~= 0),
        ignoreWalls  = (raw[7] ~= 0),
        multiHit     = (raw[8] ~= 0),
        hitfix       = (raw[9] ~= 0),
        hitboxes     = (raw[10] ~= 0),
        hitboxExpand = raw[11] - s,
        attackSpeed  = raw[12] - s,
    }
end

