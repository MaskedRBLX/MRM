-- Sword detection (for remote fallback)
local SWORD_NAMES = {
    "wood_sword", "stone_sword", "iron_sword",
    "diamond_sword", "emerald_sword", "netherite_sword",
}
local function getSwordItem()
    local inv = ReplicatedStorage:FindFirstChild("Inventories") and ReplicatedStorage.Inventories:FindFirstChild(LocalPlayer.Name)
    if not inv then return nil end
    for _, name in ipairs(SWORD_NAMES) do
        local found = inv:FindFirstChild(name)
        if found then return found end
    end
    for _, child in ipairs(inv:GetChildren()) do
        if child.Name:lower():find("sword") then return child end
    end
    return nil
end

local function holdingSwordGeneric()
    local char = LocalPlayer.Character
    if not char then return false end
    local handItem = char:FindFirstChild("HandInvItem")
    if handItem and handItem.Value then
        local n = handItem.Value.Name:lower()
        if n:find("sword") or n:find("blade") then return true end
    end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            local n = obj.Name:lower()
            if n:find("sword") or n:find("blade") then return true end
        end
    end
    return false
end

local function checkSwordEquipped()
    if bedwarsReady and bedwars.ItemMeta then return hasSwordEquipped() end
    return holdingSwordGeneric()
end

-- FULL 3D ANGLE CHECK (camera direction, no flicker)
local cachedAngleDeg, cachedCos = -1, 0
local function getAngleCos()
    if config.angleDeg ~= cachedAngleDeg then
        cachedAngleDeg = config.angleDeg
        cachedCos = math.cos(math.rad(config.angleDeg / 2))
    end
    return cachedCos
end

local function inAngleCone(cameraCF, rootPos, targetPos)
    if config.angleDeg >= 360 then return true end
    local toTarget = (targetPos - rootPos).Unit          -- full 3D
    local forward  = cameraCF.LookVector.Unit            -- full 3D
    return forward:Dot(toTarget) >= getAngleCos()
end

-- Wall check
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function refreshRayFilter()
    local char = LocalPlayer.Character
    rayParams.FilterDescendantsInstances = char and { char } or {}
end

local function isVisible(fromPos, toPos)
    if not config.ignoreWalls then return true end
    refreshRayFilter()
    local dir = toPos - fromPos
    local result = workspace:Raycast(fromPos, dir, rayParams)
    if not result then return true end
    local hit = result.Instance
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and hit:IsDescendantOf(p.Character) then return true end
    end
    return false
end

-- FireServer fallback helpers
local netEventCache
local function getKANet()
    if netEventCache then return netEventCache end
    local ok, v = pcall(function()
        return ReplicatedStorage
            .rbxts_include.node_modules
            :FindFirstChild("@rbxts")
            .net.out._NetManaged.SwordHit
    end)
    if ok and v then netEventCache = v end
    return netEventCache
end

