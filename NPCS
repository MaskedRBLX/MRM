-- Cooldown timer
local lastAttackTime = 0

-- Pre-allocated target table
local targetList = {}

-- ========== MAIN KILLAURA LOOP (HEARTBEAT) ==========
RunService.Heartbeat:Connect(function()
    if not config.enabled then return end
    if config.requireMouse and not lmbHeld then return end
    if config.limitToItems and not checkSwordEquipped() then return end

    local root = getRoot()
    if not root then return end
    local lpPos = root.Position
    local localHum = getHumanoid()
    if not localHum or localHum.Health <= 0 then return end

    local camCF = Camera.CFrame

    table.clear(targetList)

    for _, ent in ipairs(entitylib.List) do
        if not ent.Targetable then continue end
        if not entitylib.isVulnerable(ent) then continue end
        if config.teamCheck and ent.Player then
            local localTeam = LocalPlayer.Team
            local entTeam = ent.Player.Team
            if localTeam and entTeam and entTeam == localTeam then continue end
        end
        local pRoot = ent.RootPart
        if not pRoot then continue end
        local pPos = pRoot.Position
        local dist = (lpPos - pPos).Magnitude
        if dist > config.range then continue end
        if not inAngleCone(camCF, lpPos, pPos) then continue end    -- FULL 3D
        if not isVisible(lpPos, pPos) then continue end
        table.insert(targetList, { char = ent.Character, pPos = pPos, dist = dist })
    end

    table.sort(targetList, function(a, b) return a.dist < b.dist end)

    if #targetList > 0 then
        -- Cooldown check: only attack if enough time has passed since last swing
        local now = tick()
        if now - lastAttackTime >= config.attackSpeed then
            -- PRIMARY METHOD: Real sword swing (no camera flicker)
            if bedwarsReady and bedwars.SwordController and bedwars.SwordController.swingSwordInRegion then
                local swingSize = config.hitboxes and (config.hitboxExpand / 3) or 3.8
                for _, t in ipairs(targetList) do
                    local regionCF = CFrame.new(t.pPos)
                    pcall(function()
                        bedwars.SwordController:swingSwordInRegion(regionCF, swingSize)
                    end)
                    if not config.multiHit then break end
                end
                lastAttackTime = now
            else
                -- FALLBACK: FireServer remote (if Vape engine not ready)
                local net = getKANet()
                local sword = getSwordItem()
                if net and sword then
                    for _, t in ipairs(targetList) do
                        local fireSelfPos = lpPos
                        if config.hitfix then
                            local distance = t.dist
                            local pingCompensation = math.min(getPingMs() / 1000 * 50, 8)
                            local adjustmentDist = math.max(distance - 12, 0) + pingCompensation
                            if adjustmentDist > 0 then
                                local direction = CFrame.lookAt(lpPos, t.pPos).LookVector
                                fireSelfPos = lpPos + (direction * adjustmentDist)
                            end
                        end
                        local args = {{
                            entityInstance = t.char,
                            chargedAttack = { chargeRatio = 0 },
                            validate = {
                                targetPosition = { value = t.pPos },
                                selfPosition = { value = fireSelfPos },
                            },
                            weapon = sword,
                        }}
                        pcall(net.FireServer, net, unpack(args))
                        if not config.multiHit then break end
                    end
                    lastAttackTime = now
                end
            end
        end
    end
end)

