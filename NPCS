    end

    knob.MouseButton1Down:Connect(function()
        dragging = true
    end)
    pain.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    pain.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateKnob(input.Position.X)
        end
    end)
    updateKnob(knob.AbsolutePosition.X + knob.AbsoluteSize.X/2)
    local ctrl = {Set = function(v) updateKnob(bar.AbsolutePosition.X + (v-min)/(max-min)*bar.AbsoluteSize.X) end}
    table.insert(uiControls, {ctrl = ctrl, key = key, type = "slider"})
    return ctrl
end

local function _addKeybind(parent, text, default, callback, key)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1,-10,0,30)
    frame.Position = UDim2.new(0,5,0,_offset)
    frame.BackgroundTransparency = 1
    frame.Parent = parent
    _offset = _offset + 33

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.5,0,1,0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255,255,255)
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0,80,0,22)
    btn.Position = UDim2.new(1,-85,0.5,-11)
    btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
    btn.Text = default.Name
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.Code
    btn.TextSize = 12
    btn.Parent = frame

    local listening = false
    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "..."
        local conn; conn = pain.InputBegan:Connect(function(input, gp)
            if gp or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if listening then
                listening = false
                conn:Disconnect()
                local key = input.KeyCode
                btn.Text = key.Name
                callback(key)
            end
        end)
    end)
    local ctrl = {Set = function(k) btn.Text = k.Name; callback(k) end}
    table.insert(uiControls, {ctrl = ctrl, key = key, type = "keybind"})
    return ctrl
end

-- Save/Load profile via file (exploit environment)
local profilePath = "37HITMASKED_config.json"
local autoSaveScheduled = false

local function saveProfile()
    local data = {
        enabled = cfg.enabled,
        range = cfg.range,
        teamCheck = cfg.teamCheck,
        angleDeg = cfg.angleDeg,
        requireMouse = cfg.requireMouse,
        limitToItems = cfg.limitToItems,
        ignoreWalls = cfg.ignoreWalls,
        multiHit = cfg.multiHit,
        hitfix = cfg.hitfix,
        hitboxes = cfg.hitboxes,
        hitboxExpand = cfg.hitboxExpand,
        attackSpeed = cfg.attackSpeed,
        kaToggleKey = kaToggleKey.Name,
        uiToggleKey = uiToggleKey.Name,
    }
    local json = http:JSONEncode(data)
    if writefile then
        pcall(function() writefile(profilePath, json) end)
    end
end

local function loadProfile()
    if not isfile or not readfile or not isfile(profilePath) then return false end
    local json = readfile(profilePath)
    local data = http:JSONDecode(json)
    if not data then return false end

    if data.range ~= nil then cfg.range = math.clamp(data.range, 1, 40) end
    if data.enabled ~= nil then cfg.enabled = data.enabled end
    if data.teamCheck ~= nil then cfg.teamCheck = data.teamCheck end
    if data.angleDeg ~= nil then cfg.angleDeg = math.clamp(data.angleDeg, 0, 360) end
    if data.requireMouse ~= nil then cfg.requireMouse = data.requireMouse end
    if data.limitToItems ~= nil then cfg.limitToItems = data.limitToItems end
    if data.ignoreWalls ~= nil then cfg.ignoreWalls = data.ignoreWalls end
    if data.multiHit ~= nil then cfg.multiHit = data.multiHit end
    if data.hitfix ~= nil then cfg.hitfix = data.hitfix end
    if data.hitboxes ~= nil then cfg.hitboxes = data.hitboxes end
    if data.hitboxExpand ~= nil then cfg.hitboxExpand = math.clamp(data.hitboxExpand, 0, 200) end
    if data.attackSpeed ~= nil then cfg.attackSpeed = data.attackSpeed end
    if data.kaToggleKey then kaToggleKey = Enum.KeyCode[data.kaToggleKey] or Enum.KeyCode.Q end
    if data.uiToggleKey then uiToggleKey = Enum.KeyCode[data.uiToggleKey] or Enum.KeyCode.RightControl end

    if bedReady then
        applyReach(cfg.range)
        applyHitboxes(cfg.hitboxes, cfg.hitboxExpand)
    end
    cachedAng = -1  -- force angle recalc
    return true
end

local function triggerAutoSave()
    if autoSaveScheduled then return end
    autoSaveScheduled = true
    task.delay(1, function()
        autoSaveScheduled = false
        saveProfile()
    end)
end


local function _cfg(key, val)
    if key == "range" then
        cfg.range = val
        if bedReady then applyReach(val) end
    elseif key == "angleDeg" then
        cfg.angleDeg = val
        cachedAng = -1
    elseif key == "hitboxExpand" then
        cfg.hitboxExpand = val
        if bedReady and cfg.hitboxes then applyHitboxes(true, val) end
    elseif key == "hitboxes" then
        cfg.hitboxes = val
        if bedReady then applyHitboxes(val, cfg.hitboxExpand) end
    else
        cfg[key] = val
    end
    triggerAutoSave()
end


